{
  "name": "mediakit-player",
  "version": "0.1.0",
  "description": "Custom React video/audio player with captions, playback rate, picture-in-picture, fullscreen, and volume controls.",
  "license": "MIT",
  "author": "Kalvin Chakma",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "video",
    "player",
    "react",
    "video-player",
    "html5-video"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalvin-chakma/mediakit-player.git"
  },
  "homepage": "https://github.com/kalvin-chakma/mediakit-player#readme",
  "bugs": "https://github.com/kalvin-chakma/mediakit-player/issues",
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.3.6",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5"
  }
}
